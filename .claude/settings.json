{
  "enabledPlugins": {
    "aiup-core@ai-unified-process-marketplace": true,
    "quarkus-agent@quarkus-tools": true
  },
  "extraKnownMarketplaces": {
    "ai-unified-process-marketplace": {
      "source": {
        "source": "github",
        "repo": "AI-Unified-Process/marketplace"
      }
    },
    "quarkus-tools": {
      "source": {
        "source": "github",
        "repo": "quarkusio/quarkus-agent-mcp"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/branch-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
